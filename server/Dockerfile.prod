FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json tsconfig.json ./
COPY server/package.json ./server/
COPY shared/package.json ./shared/

RUN npm ci

COPY server/ ./server/
COPY shared/ ./shared/

RUN npm run build --workspace=@shared/types
RUN npm run build --workspace=split-app-server


FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY server/package.json ./server/
COPY shared/package.json ./shared/

RUN npm ci --omit=dev

COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/shared/dist ./shared/dist

COPY server/.sequelizerc ./server/.sequelizerc
COPY server/src/infrastructure/database/config.js ./server/src/infrastructure/database/config.js
COPY server/src/infrastructure/database/migrations ./server/src/infrastructure/database/migrations

WORKDIR /app/server

CMD ["node", "dist/index.js"]